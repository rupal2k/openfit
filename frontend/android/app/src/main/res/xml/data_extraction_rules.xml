<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Health data (lab reports, weights, meals, workouts) must not go to the Google
     cloud backup: the app promises "no cloud". Moving to a new phone (device-to-device transfer)
     still copies everything; Export backup in Settings is the other supported path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <!-- no <device-transfer> section: the default copies everything to the new phone -->
</data-extraction-rules>
