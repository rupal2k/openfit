# openGym environment configuration example

# WebAuthn Relying Party ID (domain/hostname passkeys are bound to, e.g. localhost or gym.example.com)
RP_ID=localhost

# Full origin URL passkey requests originate from
ORIGIN=http://localhost:8080

# Host port exposed for web service
WEB_PORT=8080

# Name displayed in WebAuthn prompts
RP_NAME=openGym

# Comma-separated user IDs that have admin access (optional)
ADMIN_UIDS=

# Set to 1 to require invite code for registration (optional)
INVITE_ONLY=0
