<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 (data_extraction_rules.xml covers 12+). These versions can't tell a cloud backup
     from a phone-to-phone transfer here, so nothing is backed up: no health data goes to the
     Google cloud. Export backup in Settings is the way to move data on these versions. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
